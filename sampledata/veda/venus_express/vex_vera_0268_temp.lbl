PDS_VERSION_ID = PDS3
RECORD_TYPE = STREAM
^TABLE = "vex_vera_0268_temp.tab"
MISSION_NAME = "VENUS EXPRESS"
SPACECRAFT_NAME = "VENUS EXPRESS"
INSTRUMENT_NAME = "VENUS RADIO SCIENCE EXPERIMENT"
INSTRUMENT_ID = "VERA"
TARGET_NAME = "VENUS"
START_TIME = 2007-01-14T18:40:00Z

OBJECT = TABLE
  COLUMNS = 4
  ROWS = 111
  INTERCHANGE_FORMAT = ASCII
  ROW_BYTES = 48

  OBJECT = COLUMN
    NAME = "ALTITUDE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 1
    BYTES = 10
    UNIT = "KM"
    DESCRIPTION = "Altitude above Venus datum (R=6051.8 km)"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "TEMPERATURE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 13
    BYTES = 10
    UNIT = "K"
    DESCRIPTION = "Venus mesosphere temperature"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "PRESSURE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 25
    BYTES = 14
    UNIT = "HPA"
    DESCRIPTION = "Atmospheric pressure in hPa"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "REFRACTIVITY"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 41
    BYTES = 12
    UNIT = "N-UNITS"
    DESCRIPTION = "Atmospheric refractivity"
  END_OBJECT = COLUMN

END_OBJECT = TABLE
END
