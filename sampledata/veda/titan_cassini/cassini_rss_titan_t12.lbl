PDS_VERSION_ID = PDS3
RECORD_TYPE = STREAM
^TABLE = "cassini_rss_titan_t12.tab"
MISSION_NAME = "CASSINI-HUYGENS"
SPACECRAFT_NAME = "CASSINI-HUYGENS"
INSTRUMENT_NAME = "RADIO SCIENCE SUBSYSTEM"
INSTRUMENT_ID = "RSS"
TARGET_NAME = "TITAN"
START_TIME = 2006-03-19T00:14:00Z

OBJECT = TABLE
  COLUMNS = 4
  ROWS = 151
  INTERCHANGE_FORMAT = ASCII
  ROW_BYTES = 48

  OBJECT = COLUMN
    NAME = "ALTITUDE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 1
    BYTES = 10
    UNIT = "KM"
    DESCRIPTION = "Altitude above Titan reference sphere (R=2575 km)"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "TEMPERATURE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 13
    BYTES = 10
    UNIT = "K"
    DESCRIPTION = "Atmospheric temperature in Kelvin"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "PRESSURE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 25
    BYTES = 14
    UNIT = "HPA"
    DESCRIPTION = "Atmospheric pressure in hPa"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "REFRACTIVITY"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 41
    BYTES = 12
    UNIT = "N-UNITS"
    DESCRIPTION = "Radio refractivity index"
  END_OBJECT = COLUMN

END_OBJECT = TABLE
END
