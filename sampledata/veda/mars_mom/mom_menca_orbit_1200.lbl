PDS_VERSION_ID = PDS3
RECORD_TYPE = STREAM
^TABLE = "mom_menca_orbit_1200.tab"
MISSION_NAME = "MARS ORBITER MISSION"
SPACECRAFT_NAME = "MARS ORBITER MISSION"
INSTRUMENT_NAME = "MARS EXOSPHERIC NEUTRAL COMPOSITION ANALYSER"
INSTRUMENT_ID = "MENCA"
TARGET_NAME = "MARS"
START_TIME = 2015-03-04T06:12:00Z

OBJECT = TABLE
  COLUMNS = 5
  ROWS = 101
  INTERCHANGE_FORMAT = ASCII
  ROW_BYTES = 48

  OBJECT = COLUMN
    NAME = "ALTITUDE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 1
    BYTES = 10
    UNIT = "KM"
    DESCRIPTION = "Altitude above Mars mean aeroid"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "TEMPERATURE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 13
    BYTES = 10
    UNIT = "K"
    DESCRIPTION = "Exospheric neutral temperature"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "PRESSURE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 25
    BYTES = 14
    UNIT = "HPA"
    DESCRIPTION = "Neutral exospheric partial pressure"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "CO2_DENSITY"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 41
    BYTES = 14
    UNIT = "M**-3"
    DESCRIPTION = "Carbon dioxide number density"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "ARGON_DENSITY"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 57
    BYTES = 14
    UNIT = "M**-3"
    DESCRIPTION = "Argon-40 number density"
  END_OBJECT = COLUMN

END_OBJECT = TABLE
END
