PDS_VERSION_ID = PDS3
RECORD_TYPE = STREAM
^TABLE = "lro_diviner_shackleton.tab"
MISSION_NAME = "LUNAR RECONNAISSANCE ORBITER"
SPACECRAFT_NAME = "LUNAR RECONNAISSANCE ORBITER"
INSTRUMENT_NAME = "DIVINER LUNAR RADIOMETER"
INSTRUMENT_ID = "DIVINER"
TARGET_NAME = "MOON"
START_TIME = 2018-09-22T04:10:00Z

OBJECT = TABLE
  COLUMNS = 3
  ROWS = 51
  INTERCHANGE_FORMAT = ASCII
  ROW_BYTES = 48

  OBJECT = COLUMN
    NAME = "ALTITUDE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 1
    BYTES = 10
    UNIT = "KM"
    DESCRIPTION = "Lunar polar altitude above crater floor"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "TEMPERATURE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 13
    BYTES = 10
    UNIT = "K"
    DESCRIPTION = "Diviner infrared thermal brightness"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "RADIANCE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 25
    BYTES = 14
    UNIT = "W/(M**2*SR)"
    DESCRIPTION = "Surface thermal radiance"
  END_OBJECT = COLUMN

END_OBJECT = TABLE
END
