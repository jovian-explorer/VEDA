SOURCE_PRODUCT_ID        =  "M32ICL2L03_IIX_040931105_60.TAB"
DESCRIPTION              =  "This file contains an ionospheric
                             electron density profile derived from Mars
                             Express single frequency radio occultation
                             data. Raw samples of ground station
                             receiver output were corrected for observing
                             conditions and converted to bending angle
                             as a function of impact parameter. These
                             results were then inverted to refractive index
                             as a function of radius via an Abel transform.
                             Electron number density was obtained from
                             refractive index using a conversion formula
                             appropriate to the measurement frequency."

