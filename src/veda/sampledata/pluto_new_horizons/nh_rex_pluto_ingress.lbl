PDS_VERSION_ID = PDS3
RECORD_TYPE = STREAM
^TABLE = "nh_rex_pluto_ingress.tab"
MISSION_NAME = "NEW HORIZONS"
SPACECRAFT_NAME = "NEW HORIZONS"
INSTRUMENT_NAME = "RADIO SCIENCE EXPERIMENT"
INSTRUMENT_ID = "REX"
TARGET_NAME = "PLUTO"
START_TIME = 2015-07-14T11:49:00Z

OBJECT = TABLE
  COLUMNS = 4
  ROWS = 101
  INTERCHANGE_FORMAT = ASCII
  ROW_BYTES = 48

  OBJECT = COLUMN
    NAME = "ALTITUDE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 1
    BYTES = 10
    UNIT = "KM"
    DESCRIPTION = "Altitude above Pluto reference surface"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "PRESSURE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 13
    BYTES = 14
    UNIT = "HPA"
    DESCRIPTION = "Atmospheric pressure in hPa"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "TEMPERATURE"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 29
    BYTES = 10
    UNIT = "K"
    DESCRIPTION = "Atmospheric kinetic temperature in Kelvin"
  END_OBJECT = COLUMN

  OBJECT = COLUMN
    NAME = "REFRACTIVITY"
    DATA_TYPE = ASCII_REAL
    START_BYTE = 41
    BYTES = 12
    UNIT = "N-UNITS"
    DESCRIPTION = "Radio refractivity index"
  END_OBJECT = COLUMN

END_OBJECT = TABLE
END
