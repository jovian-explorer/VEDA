    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pds.nasa.gov/pds4/pds/v1 http://pds.nasa.gov/pds4/pds/v1/PDS4_PDS_1L00.xsd">
    
    <Identification_Area>
        <logical_identifier>urn:nasa:pds:nh_derived:plutosystem_atmospherics:nh_pluto_rex_profile_entry</logical_identifier>
        <version_id>1.0</version_id>
        <title>
            Pluto Atmospheric Composition Profiles: Radio Science Atmospheric Temperature-Pressure
            Profile, Occultation Entry, from the New Horizons Radio Science Experiment
        </title>
        <information_model_version>1.21.0.0</information_model_version>
        <product_class>Product_Observational</product_class>
        
        <Alias_List>
            <Alias>
                <alternate_id>NH-P/PSA-LORRI/ALICE/REX-5-ATMOS-V2.0:NH_PLUTO_REX_PROFILE_ENTRY</alternate_id>
                <comment>PDS3 product identifier</comment>
            </Alias>
        </Alias_List>
        
        <Modification_History>
            <Modification_Detail>
                <modification_date>2025-05-06</modification_date>
                <version_id>1.0</version_id>
                <description>
                    ACR: Minimal effort migration from PDS3
                </description>
            </Modification_Detail>
        </Modification_History>
    </Identification_Area>
    
    <Observation_Area>
        <Time_Coordinates>
            <start_date_time>2015-07-14T12:17:30Z</start_date_time>
            <stop_date_time>2015-07-14T13:25:34Z</stop_date_time>
        </Time_Coordinates>
        
        <Primary_Result_Summary>
            <purpose>Science</purpose>
            <processing_level>Derived</processing_level>
        </Primary_Result_Summary>
        
        <Investigation_Area>
            <name>New Horizons</name>
            <type>Mission</type>
            <Internal_Reference>
                <lid_reference>urn:nasa:pds:context:investigation:mission.new_horizons</lid_reference>
                <reference_type>data_to_investigation</reference_type>
            </Internal_Reference>
        </Investigation_Area>
        
        <Observing_System>
            <Observing_System_Component>
                <name>New Horizons</name>
                <type>Host</type>
                <Internal_Reference>
                    <lid_reference>urn:nasa:pds:context:instrument_host:spacecraft.nh</lid_reference>
                    <reference_type>is_instrument_host</reference_type>
                </Internal_Reference>
            </Observing_System_Component>
