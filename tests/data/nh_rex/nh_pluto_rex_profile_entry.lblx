                The overview document for this collection provides details of and references for the 
                production of each of the products in the collection.
            </comment>
        </Internal_Reference>
    </Reference_List>
    
    <File_Area_Observational>
        <File>
            <file_name>nh_pluto_rex_profile_entry.tab</file_name>
        </File>
        
        <Table_Character>
            <name>Azimuthal average profile</name>
            <offset unit="byte">0</offset>
            <records>29</records>
            <description>
                This file contains the atmospheric pressure-temperature profile     
                derived from measurements at occultation entry, which occurred at sunset      
                near the center of the anti-Charon hemisphere.
                
                Note that the gutter space between fields contains a comma (',')
                character, so that this file could also be read as a CSV file.
            </description>
            <record_delimiter>Carriage-Return Line-Feed</record_delimiter>
            <Record_Character>
                <fields>12</fields>
                <groups>0</groups>
                <record_length unit="byte">75</record_length>
                
                <Field_Character>
                    <name>Altitude</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">5</field_length>
                    <field_format>%5.1f</field_format>
                    <unit>km</unit>
                    <description>
                        Measurement altitude from local surface      
                        of Pluto.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Radius</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">7</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">6</field_length>
                    <field_format>%6.1f</field_format>
                    <unit>km</unit>
                    <description>
                        Measurement radius from center of mass       
                        of Pluto.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Longitude</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">14</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">5</field_length>
                    <field_format>%5.1f</field_format>
                    <unit>deg</unit>
                    <description>
                        Planetocentric (positive east) longitude of           
                        measurement in body fixed coordinates (IAU small body pole                
                        convention).
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Latitude</name>
                    <field_number>4</field_number>
                    <field_location unit="byte">20</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">5</field_length>
                    <field_format>%5.1f</field_format>
                    <unit>deg</unit>
                    <description>
                        Planetocentric (north) latitude of           
                        measurement (IAU small body pole convention).
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Local True Solar Time</name>
                    <field_number>5</field_number>
                    <field_location unit="byte">26</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">5</field_length>
                    <field_format>%5.2f</field_format>
                    <unit>hour</unit>
                    <description>
                        Local true solar time (LTST) at the          1234567890
                        time and location of the occultation measurement.  LTST at the            
                        sub-solar longitude is defined as 12 solar hours.  LTST on other          
                        meridians changes by one solar hour for each 15 degree increment          
                        in longitude.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Solar Zenith Angle</name>
                    <field_number>6</field_number>
                    <field_location unit="byte">32</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">4</field_length>
                    <field_format>%4.1f</field_format>
                    <unit>deg</unit>
                    <description>
                        Angle between the direction to Sun           
                        and the local vertical direction on Pluto at time and location            
                        of the occultation measurement.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Number Density</name>
                    <field_number>7</field_number>
                    <field_location unit="byte">37</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">6</field_length>
                    <field_format>%6.2f</field_format>
                    <unit>m**-3</unit>
                    <scaling_factor>1.e19</scaling_factor>
                    <description>
                        Molecular number density of the              
                        atmosphere at RADIUS.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Sigma Number Density</name>
                    <field_number>8</field_number>
                    <field_location unit="byte">44</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">4</field_length>
                    <field_format>%4.2f</field_format>
                    <unit>m**-3</unit>
                    <scaling_factor>1.e19</scaling_factor>
                    <description>
                        One standard deviation uncertainty           
                        in NUMBER DENSITY.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Pressure</name>
                    <field_number>9</field_number>
                    <field_location unit="byte">49</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">6</field_length>
                    <field_format>%6.4f</field_format>
                    <unit>pascal</unit>
                    <description>
                        Atmospheric pressure at RADIUS.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Sigma Pressure</name>
                    <field_number>10</field_number>
                    <field_location unit="byte">56</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">6</field_length>
                    <field_format>%6.4f</field_format>
                    <unit>pascal</unit>
                    <description>
                        One standard deviation uncertainty           
                        in PRESSURE.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Temperature</name>
                    <field_number>11</field_number>
                    <field_location unit="byte">63</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">6</field_length>
                    <field_format>%6.2f</field_format>
                    <unit>kelvin</unit>
                    <description>
                        Atmospheric temperature at RADIUS.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Sigma Temperature</name>
                    <field_number>12</field_number>
                    <field_location unit="byte">70</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">4</field_length>
                    <field_format>%4.2f</field_format>
                    <unit>kelvin</unit>
                    <description>
                        One standard deviation uncertainty           
                        in TEMPERATURE.
                    </description>
                </Field_Character>
                
            </Record_Character>
        </Table_Character>
    </File_Area_Observational>
</Product_Observational>